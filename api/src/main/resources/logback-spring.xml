<?xml version="1.0" encoding="UTF-8"?>
<configuration debug="false">
    <include resource="org/springframework/boot/logging/logback/defaults.xml"/>

    <contextListener class="ch.qos.logback.classic.jul.LevelChangePropagator">
        <resetJUL>true</resetJUL>
    </contextListener>

    <springProperty scope="context" name="springAppName" source="spring.application.name" defaultValue="oneview-undefined-application-name"/>

    <conversionRule
            conversionWord="stacktrace"
            class="net.logstash.logback.stacktrace.ShortenedThrowableConverter"/>

    <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
        <encoder class="net.logstash.logback.encoder.LoggingEventCompositeJsonEncoder">
            <providers>
                <timestamp>
                    <timeZone>UTC</timeZone>
                </timestamp>
                <pattern>
                    <pattern>
                        {
                        "severity": "%level",
                        "logLevel": "%level",
                        "service": "${springAppName:-}",
                        "dt.span_id": "%X{dt.span_id:-}",
                        "dt.trace_id": "%X{dt.trace_id:-}",
                        "parent": "%X{X-B3-ParentSpanId:-}",
                        "exportable": "%X{X-Span-Export:-}",
                        "pid": "${PID:-}",
                        "thread": "%thread",
                        "class": "%logger{40}",
                        "message": "%message"
                        }
                    </pattern>
                </pattern>
                <arguments />
                <stackTrace>
                    <throwableConverter class="net.logstash.logback.stacktrace.ShortenedThrowableConverter">
                        <maxDepthPerThrowable>30</maxDepthPerThrowable>
                        <maxLength>2048</maxLength>
                        <shortenedClassNameLength>20</shortenedClassNameLength>
                        <exclude>^sun\.reflect\..*\.invoke</exclude>
                        <exclude>^net\.sf\.cglib\.proxy\.MethodProxy\.invoke</exclude>

                        <rootCauseFirst>true</rootCauseFirst>
                    </throwableConverter>
                </stackTrace>
            </providers>
        </encoder>
    </appender>

    <logger name="com.rogers" level="INFO" />
    <logger name="org.springframework" level="WARN" />
    <logger name="org.springframework.boot.actuate.endpoint" level="INFO" />
    <logger name="org.springframework.web" level="WARN" />
    <logger name="org.springframework.security" level="WARN" />
    <logger name="org.hibernate" level="WARN" />
    <logger name="org.hibernate.type.descriptor.sql" level="WARN" />
    <logger name="org.apache" level="WARN" />
    <logger name="io.netty" level="WARN" />
    <logger name="feign" level="WARN" />
    <logger name="com.zaxxer" level="WARN" />
    <logger name="reactor" level="WARN" />
    <logger name="org.eclipse.jetty" level="WARN" />
    <logger name="io.swagger" level="WARN" />
    <logger name="org.springdoc" level="WARN" />

    <springProfile name="local-env">
        <root level="INFO">
            <appender-ref ref="STDOUT"/>
        </root>
    </springProfile>

    <springProfile name="!local-env">
        <root level="INFO">
            <appender-ref ref="STDOUT"/>
        </root>
    </springProfile>

</configuration>